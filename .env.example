# Copy to the ignored root .env; never put real credentials in this template.
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/jenosize_crm
PG_POOL_MAX=5
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Required: generate a private random value (at least 32 UTF-8 bytes).
JWT_SECRET=

# Private initial admin creation: npm run db:bootstrap-admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional fictional sales users: npm run db:seed (at least 12 characters).
DEMO_SEED_PASSWORD=

AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LINE_MODE=mock
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
